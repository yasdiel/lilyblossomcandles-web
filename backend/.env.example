# MongoDB. Para Atlas o una instancia con autenticación, usa la cadena completa.
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=lilyblossom
MONGO_TIMEOUT_MS=3000

# Credenciales de la cuenta de administración (solo se usan al crear la cuenta).
ADMIN_EMAIL=admin@lilyblossomcandles.com
ADMIN_PASSWORD=define-una-contraseña-segura

# Sesión del panel (horas).
SESSION_HOURS=12

# Tamaño máximo de cada imagen en MB.
MAX_UPLOAD_MB=5

# Ponlo en true cuando la web use HTTPS.
COOKIE_SECURE=false

# Orígenes permitidos para desarrollo con Vite.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rutas opcionales (relativas a la carpeta backend/).
# UPLOADS_DIR=uploads
# FRONTEND_DIST=../LilyBlossom/dist
